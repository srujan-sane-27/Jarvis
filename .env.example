# ========================================================
# PROJECT JARVIS - Environment Configuration
# ========================================================

# AI Model Configuration (Google Gemini Free Tier / Pro)
# Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Security & Voice Authorization
# Spoken or typed security passphrase required to unlock Jarvis and authenticate sensitive actions
JARVIS_SECRET_CODE=omega-protocol-9
SESSION_TIMEOUT_MINUTES=10

# Voice Engine Settings
# edge-tts voice options: en-GB-RyanNeural (Jarvis style), en-US-ChristopherNeural, en-US-GuyNeural
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Mail Automation (IMAP / SMTP)
# Dedicated agent account for mail reading/automation (Never commit real credentials)
EMAIL_USER=sanesrujan84@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./jarvis.db
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
